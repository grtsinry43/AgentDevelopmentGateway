{
  "name": "@agent-gateway/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src test",
    "start": "node dist/index.js",
    "test": "tsc -p tsconfig.test.json --noEmit && tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agent-gateway/adapter-claude": "workspace:*",
    "@agent-gateway/adapter-codex": "workspace:*",
    "@agent-gateway/adapter-opencode": "workspace:*",
    "@agent-gateway/core": "workspace:*",
    "@agent-gateway/runtime": "workspace:*",
    "@agent-gateway/shared": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "better-sqlite3": "^13.0.2",
    "fastify": "^5.10.0",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "tsx": "^4.23.1"
  }
}
